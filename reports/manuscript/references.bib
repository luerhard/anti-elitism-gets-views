@article{Cottanetworkanalysis20102013,
  title = {A Network Analysis of the 2010 {{FIFA}} World Cup Champion Team Play},
  author = {Cotta, Carlos and Mora, Antonio M. and Merelo, Juan Julián and Merelo-Molina, Cecilia},
  date = {2013-02-01},
  journaltitle = {Journal of Systems Science and Complexity},
