@article{wang:ConsistencyValidityInterdisciplinarity.2019,
  title = {Consistency and Validity of Interdisciplinarity Measures},
  author = {Wang, Qi and Schneider, Jesper Wiborg},
  date = {2019-10-11},
  journaltitle = {Quantitative Science Studies},
  volume = {1},
  number = {1},
  pages = {239--263},
  doi = {10.1162/qss_a_00011},
  url = {https://doi.org/10.1162/qss_a_00011},
  urldate = {2021-03-08},
  abstract = {Measuring interdisciplinarity is a pertinent but challenging issue in quantitative studies of science. There seems to be a consensus in the literature that the concept of interdisciplinarity is multifaceted and ambiguous. Unsurprisingly, various different measures of interdisciplinarity have been proposed. However, few studies have thoroughly examined the validity and relations between these measures. In this study, we present a systematic review of these interdisciplinarity measures and explore their inherent relations. We examine these measures in relation to the Web of Science journal subject categories. Our results corroborate recent claims that the current measurements of interdisciplinarity in science studies are both confusing and unsatisfying. We find surprisingly deviant results when comparing measures that supposedly should capture similar features or dimensions of the concept of interdisciplinarity. We therefore argue that the current measurements of interdisciplinarity should be interpreted with much caution in science and evaluation studies, or in relation to science policies. We also question the validity of current measures and argue that we do not need more of the same, but rather something different in order to be able to measure the multidimensional and complex construct of interdisciplinarity.},
  file = {/home/lukas/Zotero/storage/DR9DNELL/Wang_Schneider_2019_Consistency and validity of interdisciplinarity measures.pdf}
}

@article{wang:InterdisciplinarityImpactDistinct.2015,
  ids = {WangInterdisciplinarityImpactDistinct2015},
  title = {Interdisciplinarity and {{Impact}}: {{Distinct Effects}} of {{Variety}}, {{Balance}}, and {{Disparity}}},
  shorttitle = {Interdisciplinarity and {{Impact}}},
  author = {Wang, Jian and Thijs, Bart and Glänzel, Wolfgang},
  date = {2015-05-22},
  journaltitle = {PLOS ONE},
  shortjournal = {PLOS ONE},
  volume = {10},
  number = {5},
  pages = {e0127298},
  issn = {1932-6203},
  doi = {10.1371/journal.pone.0127298},
  url = {https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0127298},
  urldate = {2021-03-03},
  abstract = {Interdisciplinary research is increasingly recognized as the solution to today’s challenging scientific and societal problems, but the relationship between interdisciplinary research and scientific impact is still unclear. This paper studies the association between the degree of interdisciplinarity and the number of citations at the paper level. Different from previous studies compositing various aspects of interdisciplinarity into a single indicator, we use factor analysis to uncover distinct dimensions of interdisciplinarity corresponding to variety, balance, and disparity. We estimate Poisson models with journal fixed effects and robust standard errors to analyze the divergent relationships between these three factors and citations. We find that long-term (13-year) citations (1) increase at an increasing rate with variety, (2) decrease with balance, and (3) increase at a decreasing rate with disparity. Furthermore, interdisciplinarity also affects the process of citation accumulation: (1) although variety and disparity have positive effects on long-term citations, they have negative effects on short-term (3-year) citations, and (2) although balance has a negative effect on long-term citations, its negative effect is insignificant in the short run. These findings have important implications for interdisciplinary research and science policy.},
  langid = {english},
  keywords = {Bibliometrics,Citation analysis,Eigenvalues,Factor analysis,Science policy,Scientific publishing,Shannon index,Simpson index},
  file = {/home/lukas/Zotero/storage/XDRY9IWV/Wang et al_2015_Interdisciplinarity and Impact.pdf}
}

