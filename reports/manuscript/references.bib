@book{ruhrmannSchlussberichtInhaltsanalyseAuslanderbezogenen1985,
  ids = {Ruhrmann.1985},
  title = {Schlußbericht "{{Inhaltsanalyse}} Der Ausländerbezogenen {{Beiträge}} in Der {{Presse}} in Den {{Jahren}} 1981 Bis 1983 Unter Besonderer {{Berücksichtigung}} von "Ausländerfeindlichen" {{Alltagstheorien}}"},
  author = {Ruhrmann, Georg and Kollmer, JochemDaheim Hansjürgen and Hoffmann, Lutz},
  date = {1985},
  location = {Bielefeld},
  abstract = {Ziel der Studie ist es, den Zeitungsleser und den Journalisten gegenüber der Ausländerberichterstattung der Bielefelder Presse (Neue Westfälische, Westfalen-Blatt) zu sensibilisieren. Der Forschungsbericht ist in drei Teile gegliedert: Er enthält theoretisch-methodische Ausführungen (1.-3. Abschnitt), ausführliche Beschreibungen der Ergebnisse (4.-6. Abschnitt) und einen Anhang, der das Erhebungsinstrument (Codierbuch) und weitere Ergebnistabellen enthält. Im ersten Abschnitt werden unter Berücksichtigung der neueren Forschungsliteratur einige für die Inhaltsanalyse der Ausländerberichterstattung wichtige Grundbegriffe aus der Kommunikations- und Wissenssoziologie erörtert. Zugleich werden Funktionen der Presse diskutiert. Spezifischere Ausführungen zum Ausländerproblem und zur Ausländerpolitik in Bielefeld erfolgen im zweiten Abschnitt. Im dritten Abschnitt werden Hinweise zur Auswahl des untersuchten Pressematerials gegeben. In Abschnitt vier werden neben formalen auch eine Reihe inhaltlicher Variablen beschrieben, die sich relativ eng an theoretische Vorarbeiten einer Soziologie der Ausländerfeindlichkeit anschließen. Der Versuch, auch die Wirkung von Ausländerberichten auf den Leser zu rekonstruieren, wird im fünften Abschnitt unternommen. Der letzte Teil ist einigen symbolischen Funktionen (Bewertungen, Handlungsanweisungen und Prognosen) der Ausländerpolitik gewidmet. (RW)},
  pagetotal = {IV, 235},
  keywords = {Ausländer,Ausländerfeindlichkeit,Ausländerpolitik,Berichterstattung,Bundesrepublik Deutschland,Kriminalität,Nordrhein-Westfalen,Presse,Problem}
}

