@incollection{GlaserWissenschaft2007,
  title = {Wissenschaft},
  booktitle = {Handbuch Governance},
  author = {Gläser, Jochen and Lange, Stefan},
  editor = {Benz, Arthur and Lütz, Susanne and Schimank, Uwe and Simonis, Georg},
