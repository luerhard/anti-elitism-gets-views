@article{CostaAnalyzingmodelingrealworld2011,
  title = {Analyzing and Modeling Real-World Phenomena with Complex Networks: {{A}} Survey of Applications},
  shorttitle = {Analyzing and Modeling Real-World Phenomena with Complex Networks},
  author = {Costa, Luciano da Fontoura and Oliveira, Osvaldo N. and Travieso, Gonzalo and Rodrigues, Francisco Aparecido and Villas Boas, Paulino Ribeiro and Antiqueira, Lucas and Viana, Matheus Palhares and Correa Rocha, Luis Enrique},
  date = {2011},
  journaltitle = {Advances in Physics},
  volume = {60},
  number = {3},
  pages = {329--412},
  issn = {0001-8732},
  doi = {10.1080/00018732.2011.572452},
  url = {http://dx.doi.org/10.1080/00018732.2011.572452},
  urldate = {2014-05-26},
  abstract = {The success of new scientific areas can be assessed by their potential in contributing to new theoretical approaches and in applications to real-world problems. Complex networks have fared extremely well in both of these aspects, with their sound theoretical basis being developed over the years and with a variety of applications. In this survey, we analyze the applications of complex networks to real-world problems and data, with emphasis in representation, analysis and modeling. A diversity of phenomena are surveyed, which may be classified into no less than 11 areas, providing a clear indication of the impact of the field of complex networks.}
}

@article{CostaCharacterizationcomplexnetworks2007,
  title = {Characterization of Complex Networks: {{A}} Survey of Measurements},
  shorttitle = {Characterization of Complex Networks},
  author = {Costa, L. da F. and Rodrigues, F. A. and Travieso, G. and Boas, P. R. Villas},
  date = {2007-01-01},
  journaltitle = {Advances in Physics},
  volume = {56},
  number = {1},
  pages = {167--242},
  issn = {0001-8732},
  doi = {10.1080/00018730601170527},
  url = {http://dx.doi.org/10.1080/00018730601170527},
  urldate = {2016-04-01},
  abstract = {Each complex network (or class of networks) presents specific topological features which characterize its connectivity and highly influence the dynamics of processes executed on the network. The analysis, discrimination, and synthesis of complex networks therefore rely on the use of measurements capable of expressing the most relevant topological features. This article presents a survey of such measurements. It includes general considerations about complex network characterization, a brief review of the principal models, and the presentation of the main existing measurements. Important related issues covered in this work comprise the representation of the evolution of complex networks in terms of trajectories in several measurement spaces, the analysis of the correlations between some of the most traditional measurements, perturbation analysis, as well as the use of multivariate statistics for feature selection and network classification. Depending on the network and the analysis task one has in mind, a specific set of features may be chosen. It is hoped that the present survey will help the proper application and interpretation of measurements.}
}

