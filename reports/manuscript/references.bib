@article{SnijdersIntroductionstochasticactorbased2010,
  title = {Introduction to Stochastic Actor-Based Models for Network Dynamics},
  author = {Snijders, Tom A. B. and family=Bunt, given=Gerhard G., prefix=van de, useprefix=true and Steglich, Christian E. G.},
  options = {useprefix=true},
  date = {2010-01},
  journaltitle = {Social Networks},
