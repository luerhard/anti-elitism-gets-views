@incollection{simmelExkursUberFremden1992,
  ids = {Simmel.1992},
  title = {Exkurs Über Den {{Fremden}}},
  booktitle = {Der {{Gast}}, Der Bleibt.{{Dimensionen}} von {{Georg Simmels Analyse}} Des {{Fremdseins}}},
  author = {Simmel, Georg},
  editor = {Loycke, Almut},
  date = {1992},
  pages = {9--16},
  publisher = {Campus Verl.},
  location = {Frankfurt am Main},
  abstract = {Der vorliegende 1908 entstandene Aufsatz von Georg Simmel analysiert "die soziologische Form des Fremden". Die Begegnung mit dem Fremden wird in erster Linie positiv erfahren, weil sich die sozialen Beziehung der Menschen grundsätzlich aus einer Einheit von Nähe und Entferntsein konstituiert. Durch seinen Eintritt in eine soziale Gruppe wird der Fremde zum Bestandteil der Einheit dieser sozialen Beziehung, wird gruppenimmanent. Über diesen Aspekt hinaus ist der Fremde vor allen Dingen als Fremder erst einmal der Objektive, der bestehende Verhältnisse aus einem objektiven, freien Blickwinkel erfährt und damit als Repräsentant der Freiheit erscheint. Mit Erkenntnis dieser Objektivität tritt gleichzeitig dann auch wieder die Erkenntnis sowohl der Nähe als auch des Entferntsein hervor, die den Fremden mit den bestehenden Verhältnissen verbindet: "Der Fremde ist uns nah, insofern wir Gleichheiten nationaler oder sozialer berufsmäßiger oder allgemein menschlicher Art zwischen ihm und uns fühlen; er ist uns fern, insofern diese Gleichheiten über ihn und uns hinausreichen und uns beide nur verbinden, weil sie überhaupt sehr viele verbinden." So wird der Fremde nur dort negativ konnotiert, wo ihm die generellen gemeinhin als menschlich anerkannten Eigenschaften und Verhaltensweisen abgesprochen werden. Hier wird der Fremde nicht als Individium anerkannt, sondern als Zugehöriger einer kategorisierten Gruppe, eines sozialen Stereotypen reduziert. So in einer starren Unabänderlichkeit begrenzt, bleibt der Fremde außerhalb der sozialen Gemeinschaft, da sie ihm die ihr eigene soziale und dialektische Beziehung der Einheit von Nähe und Entferntsein verwehrt. (psz)},
  isbn = {3-593-34727-},
  keywords = {Dialektik,Fremdbild,Gesellschaft,Konsens,Rassismus,soziale Anerkennung,soziale Beziehungen}
}

