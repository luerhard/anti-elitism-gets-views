@article{seoContentAnalysisYouTube2023,
  title = {A Content Analysis of {{YouTube}} Videos on Tinnitus in South Korea},
  author = {Seo, Hee Won and Ha, Jung Woo and Kwak, Jin Hye and Kim, Moo Keon and Byun, Hayoung and Lee, Seung Hwan and Chung, Jae Ho},
  date = {2023-08-21},
  journaltitle = {Scientific Reports},
