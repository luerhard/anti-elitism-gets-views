  pages = {516--530},
  issn = {0048-7333},
  doi = {10.1016/j.respol.2018.01.012},
  url = {https://www.sciencedirect.com/science/article/pii/S004873331830012X},
  urldate = {2021-02-22},
  abstract = {Recent highly publicized cases of scientific misconduct have raised concerns about its consequences for academic careers. Previous and anecdotal evidence suggests that these reach far beyond the fraudulent scientist and (his or) her career, affecting coauthors and institutions. Here we show that the negative effects of scientific misconduct spill over to uninvolved prior collaborators: compared to a control group, prior collaborators of misconducting scientists, who have no connection to the misconduct case, are cited 8–9\% less often afterwards. We suggest that the mechanism underlying this phenomenon is stigmatization by mere association. The result suggests that scientific misconduct generates large indirect costs in the form of mistrust towards a wider range of research findings than was previously assumed. The far-reaching fallout of misconduct implies that potential whistleblowers might be disinclined to make their concerns public in order to protect their own reputation and career.},
  langid = {english},
  keywords = {Prior collaborators,Scientific misconduct,Stigma},
  file = {/home/lukas/Zotero/storage/7RQEFMEN/Hussinger_Pellens_2019_Guilt by association.pdf;/home/lukas/Zotero/storage/GHWB732V/S004873331830012X.html}
