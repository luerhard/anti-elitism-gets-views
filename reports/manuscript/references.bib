@book{InglehartModernizationPostmodernizationCultural1997,
  title = {Modernization and {{Postmodernization}}: {{Cultural}}, {{Economic}}, and {{Political Change}} in 43 {{Societies}}},
  shorttitle = {Modernization and {{Postmodernization}}},
  author = {Inglehart, Ronald},
  date = {1997},
  publisher = {Princeton University Press},
  abstract = {Ronald Inglehart argues that economic development, cultural change, and political change go together in coherent and even, to some extent, predictable patterns. This is a controversial claim. It implies that some trajectories of socioeconomic change are more likely than others–and consequently that certain changes are foreseeable. Once a society has embarked on industrialization, for example, a whole syndrome of related changes, from mass mobilization to diminishing differences in gender roles, is likely to appear. These changes in worldviews seem to reflect changes in the economic and political environment, but they take place with a generational time lag and have considerable autonomy and momentum of their own. But industrialization is not the end of history. Advanced industrial society leads to a basic shift in values, de-emphasizing the instrumental rationality that characterized industrial society. Postmodern values then bring new societal changes, including democratic political institutions and the decline of state socialist regimes. To demonstrate the powerful links between belief systems and political and socioeconomic variables, this book draws on a unique database, the World Values Surveys. This database covers a broader range than ever before available for looking at the impact of mass publics on political and social life. It provides information from societies representing 70 percent of the world's population–from societies with per capita incomes as low as \$300 per year to those with per capita incomes one hundred times greater and from long-established democracies with market economies to authoritarian states.},
  isbn = {0-691-01180-X},
  langid = {english},
  pagetotal = {468},
  keywords = {Political Science / History & Theory,Political Science / International Relations / General,Social Science / Sociology / General}
}

