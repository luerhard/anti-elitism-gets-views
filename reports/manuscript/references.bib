@article{ruleLexicalShiftsSubstantive2015a,
  title = {Lexical Shifts, Substantive Changes, and Continuity in {{State}} of the {{Union}} Discourse, 1790–2014},
  author = {Rule, Alix and Cointet, Jean-Philippe and Bearman, Peter S.},
  date = {2015-01-09},
