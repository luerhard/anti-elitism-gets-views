@article{RandPositiveInteractionsPromote2009,
  title = {Positive {{Interactions Promote Public Cooperation}}},
  author = {Rand, David G. and Dreber, Anna and Ellingsen, Tore and Fudenberg, Drew and Nowak, Martin A.},
  date = {2009-09-04},
  journaltitle = {Science},
  volume = {325},
  number = {5945},
  eprint = {19729661},
  eprinttype = {pmid},
  pages = {1272--1275},
  issn = {0036-8075, 1095-9203},
  doi = {10.1126/science.1177418},
  url = {http://science.sciencemag.org/content/325/5945/1272},
  urldate = {2016-04-26},
  abstract = {The public goods game is the classic laboratory paradigm for studying collective action problems. Each participant chooses how much to contribute to a common pool that returns benefits to all participants equally. The ideal outcome occurs if everybody contributes the maximum amount, but the self-interested strategy is not to contribute anything. Most previous studies have found punishment to be more effective than reward for maintaining cooperation in public goods games. The typical design of these studies, however, represses future consequences for today’s actions. In an experimental setting, we compare public goods games followed by punishment, reward, or both in the setting of truly repeated games, in which player identities persist from round to round. We show that reward is as effective as punishment for maintaining public cooperation and leads to higher total earnings. Moreover, when both options are available, reward leads to increased contributions and payoff, whereas punishment has no effect on contributions and leads to lower payoff. We conclude that reward outperforms punishment in repeated public goods games and that human cooperation in such repeated settings is best supported by positive interactions with others. Reward is as good as punishment to promote cooperation, costs less, and increases the share out of resources up for grabs. Reward is as good as punishment to promote cooperation, costs less, and increases the share out of resources up for grabs.},
  langid = {english},
  file = {/home/lukas/Zotero/storage/YX74NEM2/Rand et al_2009_Positive Interactions Promote Public Cooperation.pdf}
}

