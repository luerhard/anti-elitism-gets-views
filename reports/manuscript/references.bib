  shorttitle = {Private {{Pension Planning}}},
  author = {Rowlingson, Karen},
  date = {2002-10},
  journaltitle = {Journal of Social Policy},
  volume = {31},
  number = {4},
  pages = {623--642},
  issn = {1469-7823, 0047-2794},
  doi = {10.1017/s0047279402006773},
  url = {https://www.cambridge.org/core/journals/journal-of-social-policy/article/private-pension-planning-the-rhetoric-of-responsibility-the-reality-of-insecurity/3E6435CD3AA3EA45AA5D614AE503B753},
  urldate = {2017-10-09},
  abstract = {Over the last twenty years, policy-makers have placed increasing emphasis on individual planning, particularly in relation to pensions. Planning for one's own future, and that of one's family, is increasingly upheld as a morally responsible activity. This article explores the assumptions made by policy-makers in this area. It begins with a discussion of how the rhetoric from policy-makers and policy-commentators makes considerable reference to individual planning and responsibility. The policies themselves, however, sometimes act as disincentives to make private provision and do relatively little to provide security for people's future retirement. The article then draws on empirical research including recent qualitative findings to emphasise the limited nature of private pension planning and the constraints people face in relation to this activity.}
}

