@article{SinclairReinventingauthorityembedded2000,
  title = {Reinventing Authority: {{Embedded}} Knowledge Networks and the New Global Finance},
  shorttitle = {Reinventing Authority},
  author = {Sinclair, Timothy J.},
  date = {2000},
  journaltitle = {Environment and Planning C: Government and Policy},
  volume = {18},
  number = {4},
