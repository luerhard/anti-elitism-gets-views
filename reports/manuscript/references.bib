  doi = {10.1177/0093650205277321},
  url = {http://journals.sagepub.com/doi/10.1177/0093650205277321},
  urldate = {2021-09-17},
  abstract = {An experiment investigated the impact of editorial framing on readers’ political cognitions and affect toward a different racial group. Participants read mock newspaper editorials endorsing Grutter v. Bollinger, a U.S. Supreme Court decision upholding affirmative action in higher education. The editorials were systematically manipulated to present different frames in four randomly assigned versions: remedial action, diversity, combined (both frames), and control (neither frame). Frame inductions did not significantly influence support for affirmative action. However, exposure to editorials presenting the diversity frame moderated the relation between Whites’ pretested interracial attitudes (modern racism, White guilt, and belief in White privilege) and support for affirmative action. Editorials presenting the diversity frame also induced White participants to score higher on a measure of pro-Black affect. Overall, the results suggest that frames can activate distinct social identities within the minds of readers, priming their applicability to the task at hand.},
