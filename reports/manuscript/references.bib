@article{ManeMappingtopicstopic2004,
  title = {Mapping Topics and Topic Bursts in {{PNAS}}},
  author = {Mane, Ketan K. and Börner, Katy},
  date = {2004-04-06},
  journaltitle = {Proceedings of the National Academy of Sciences},
  shortjournal = {PNAS},
  volume = {101},
  eprint = {14978278},
  eprinttype = {pmid},
  pages = {5287--5290},
  issn = {0027-8424, 1091-6490},
  doi = {10.1073/pnas.0307626100},
  url = {https://www.pnas.org/content/101/suppl_1/5287},
  urldate = {2019-04-08},
  abstract = {Scientific research is highly dynamic. New areas of science continually evolve; others gain or lose importance, merge, or split. Due to the steady increase in the number of scientific publications, it is hard to keep an overview of the structure and dynamic development of one's own field of science, much less all scientific domains. However, knowledge of “hot” topics, emergent research frontiers, or change of focus in certain areas is a critical component of resource allocation decisions in research laboratories, governmental institutions, and corporations. This paper demonstrates the utilization of Kleinberg's burst detection algorithm, co-word occurrence analysis, and graph layout techniques to generate maps that support the identification of major research topics and trends. The approach was applied to analyze and map the complete set of papers published in PNAS in the years 1982-2001. Six domain experts examined and commented on the resulting maps in an attempt to reconstruct the evolution of major research areas covered by PNAS.},
  issue = {suppl 1},
  langid = {english}
}

