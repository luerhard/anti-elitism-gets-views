  author = {Gurciullo, Stefano and Smallegan, Michael and Pereda, María and Battiston, Federico and Patania, Alice and Poledna, Sebastian and Hedblom, Daniel and Oztan, Bahattin Tolga and Herzog, Alexander and John, Peter and Mikhaylov, Slava},
