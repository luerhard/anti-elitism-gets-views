@article{alvaresPopulismExtremismMedia2016,
  title = {Populism, Extremism and Media: Mapping an Uncertain Terrain},
  shorttitle = {Populism, Extremism and Media},
  author = {Alvares, Claudia and Dahlgren, Peter},
  date = {2016-02},
  journaltitle = {European Journal of Communication},
