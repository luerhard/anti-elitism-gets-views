@article{RosvallMapsRandomWalks2008,
  title = {Maps of {{Random Walks}} on {{Complex Networks Reveal Community Structure}}},
  author = {Rosvall, Martin and Bergstrom, Carl T.},
  date = {2008-01-29},
  journaltitle = {Proceedings of the National Academy of Sciences},
  shortjournal = {PNAS},
  volume = {105},
  number = {4},
  pages = {1118--1123},
  issn = {0027-8424, 1091-6490},
  doi = {10.1073/pnas.0706851105},
  url = {http://www.pnas.org/content/105/4/1118},
  urldate = {2012-06-22},
  abstract = {To comprehend the multipartite organization of large-scale biological and social systems, we introduce an information theoretic approach that reveals community structure in weighted and directed networks. We use the probability flow of random walks on a network as a proxy for information flows in the real system and decompose the network into modules by compressing a description of the probability flow. The result is a map that both simplifies and highlights the regularities in the structure and their relationships. We illustrate the method by making a map of scientific communication as captured in the citation patterns of {$>$}6,000 journals. We discover a multicentric organization with fields that vary dramatically in size and degree of integration into the network of science. Along the backbone of the network—including physics, chemistry, molecular biology, and medicine—information flows bidirectionally, but the map reveals a directional pattern of citation from the applied fields to the basic sciences. clustering compression information theory map of science bibiometrics},
  langid = {english}
}

@article{RothDilemmataAltenpflegeLogik2007,
  title = {Dilemmata der Altenpflege: Die Logik eines prekären sozialen Feldes},
  shorttitle = {Dilemmata der Altenpflege},
  author = {Roth, Günter},
  date = {2007},
  journaltitle = {Berliner Journal für Soziologie},
  shortjournal = {BJfS},
  volume = {17},
  number = {1},
  pages = {77--96},
  issn = {0863-1808, 1862-2593},
  doi = {10.1007/s11609-007-0005-0},
  url = {http://link.springer.com/article/10.1007/s11609-007-0005-0},
  urldate = {2016-08-02},
  abstract = {Zusammenfassung Der Beitrag widmet sich zuerst deskriptiven Befunden gravierender Defizite des beruflich-institutionellen Umgangs mit den Risiken älterer pflegebedürftiger Menschen (z.B. Mangelernährung). Bei steigendem Pflegebedarf (und Verfall des ökonomischen, kulturellen und sozialen Kapitals der Pflegebedürftigen) nimmt die Qualität der Pflege ab, und es herrscht insgesamt eine wenig systematische, mangelhafte Pflege, die mit Überversorgung, Infantilisierung und Paternalismus oder gar Gewalt einhergeht. Die Hintergründe der strukturellen Probleme bleiben eher im Dunkeln — auch infolge scheinbar auf der Hand liegender Erklärung sansätze und theoretischer Annahmen. Die an Ressourcenmangel und Überlastung sowie Qualifikations-und Organisationsdefiziten ansetzenden funktionalistischen Konzepte einerseits und interpretative sowie institutionenkritische Ansätze andererseits reichen — trotz gewisser empirischer Evidenz — nicht aus, die Dilemmata des prekären sozialen Feldes Altenpflege zu verstehen. Der Aufsatz leistet einen Beitrag zur Klärung der Dilemmata unter Rückgriff auf die Feldtheorie von Bourdieu. Das heteronome Feld der Altenpflege — verortet im Spannungsverhältnis von Lebenswelt, Familie und Medizin — ist stark durch unterschiedlich (wesentlich durch die Geschlechterordnung) bedingte soziale Ungleichheiten und verkannte Machtstrukturen sowie Konflikte geprägt und geht einher mit einem disparaten, bisher wenig reflektierten Habitus der Pflegenden („Schwestern“). , Abstract The article initially deals with descriptive findings of serious deficits in the professional and institutional handling of the risks faced by elderly people needing care (e.g. malnutrition). Especially with the increasing need for care (and with the decline of their economic, cultural and social capital), these people are suffering a deteriorating quality of care, and on the whole, a rather unsystematic and unsatisfactory care situation prevails, with over-provision of care, infantilization, paternalism or even violence. In general, the background of the structural problems remains quite unexplained, which is also due to the prevalence of seemingly obvious explanations and theoretical assumptions. In spite of some empirical evidence, neither functionalist concepts that focus on both the lack of resources and overburden and on deficits in qualification and organisation nor interpretative approaches that are critical of institutions will help to understand the dilemmas of the precarious social field of the care of the elderly. These dilemmas are elucidated by means of Bourdieu’s field theory. The heteronomous field in the area of conflict between everyday life, family and medicine is strongly influenced by social inequality and unrecognised power structures with diverse causes (predominantly rooted in the order of the sexes), as well as by conflicts; and the dispositions (“Habitus”) of the nursing staff are disparate and have been paid little attention to up to now.},
  langid = {german}
}

