@article{mascarenhas:UniversityIndustryCooperation.2018,
  title = {University–Industry Cooperation: {{A}} Systematic Literature Review and Research Agenda},
  shorttitle = {University–Industry Cooperation},
  author = {Mascarenhas, Carla and Ferreira, João J and Marques, Carla},
  date = {2018-10-01},
  journaltitle = {Science and Public Policy},
