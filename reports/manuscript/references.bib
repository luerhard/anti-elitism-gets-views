@article{ArrietaQuantifyingnegativeimpact2017,
  title = {Quantifying the Negative Impact of Brain Drain on the Integration of {{European}} Science},
  author = {Arrieta, Omar A. Doria and Pammolli, Fabio and Petersen, Alexander M.},
  date = {2017-04-01},
  journaltitle = {Science Advances},
