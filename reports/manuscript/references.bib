@article{LyketsosCannabisUseCognitive1999,
  title = {Cannabis {{Use}} and {{Cognitive Decline}} in {{Persons}} under 65 {{Years}} of {{Age}}},
  author = {Lyketsos, Constantine G. and Garrett, Elizabeth and Liang, Kung-Yee and Anthony, James C.},
