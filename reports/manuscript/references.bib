@unpublished{HennekenEffectEprintingCitation2006,
  title = {Effect of {{E-Printing}} on {{Citation Rates}} in {{Astronomy}} and {{Physics}}},
  author = {Henneken, Edwin A. and Kurtz, Michael J. and Eichhorn, Guenther and Accomazzi, Alberto and Grant, Carolyn and Thompson, Donna and Murray, Stephen S.},
