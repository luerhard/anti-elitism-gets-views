@incollection{rummensPopulismThreatLiberal2017,
  title = {Populism as a {{Threat}} to {{Liberal Democracy}}},
  booktitle = {The {{Oxford Handbook}} of {{Populism}}},
  author = {Rummens, Stefan},
  editor = {Kaltwasser, Cristóbal Rovira and Taggart, Paul and Espejo, Paulina Ochoa and Ostiguy, Pierre},
  date = {2017},
  pages = {554--570},
  publisher = {Oxford University Press},
  abstract = {This chapter argues that liberal democracy and populism, despite both being committed to the idea of popular sovereignty, rely on incompatible conceptualizations of the demos and, consequently, embody antagonistic and irreconcilable understandings of the concept of democracy. It subsequently challenges the wide-spread assumption that populism might have beneficial effects. Although populism operates as a symptom, signaling an underlying malfunctioning of our liberal democratic system, it can never itself function as the remedial corrective. Instead, it should be considered an important threat to democracy, which ought to be countered by actions aiming to remedy both the symptom and the underlying problem.},
  langid = {english}
}

