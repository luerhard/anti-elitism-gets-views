  date = {2020},
  journaltitle = {IEEE Internet Computing},
  pages = {1--1},
  issn = {1941-0131},
  doi = {10.1109/mic.2020.3040516},
  abstract = {We analyse a Singapore-based COVID-19 Telegram group with more than 10,000 participants. First, we study the group's opinion over time, focusing on five dimensions: participation, sentiment, negative emotions, topics, and message types. We find that participation peaked when the Ministry of Health raised the disease alert level, but this engagement was not sustained. Second, we investigate the prevalence of, and reactions to, authority-identified misinformation in the group. We find that authority-identified misinformation is rare, and that participants affirm, deny, and question misinformation. Third, we explore searching for user skepticism as one strategy for identifying misinformation, finding misinformation not previously identified by authorities.},
  keywords = {COVID-19,Government,Group chats,Internet,Misinformation,Pandemics,Public healthcare,Sentiment Analysis,Skepticism,Social media,Social networking (online),Special issues and sections,Telegram,Topic Analysis}
