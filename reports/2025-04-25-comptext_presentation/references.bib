  author = {Bene, Márton and Magin, Melanie and Haßler, Jörg and Russmann, Uta and Lilleker, Darren and Kruschinski, Simon and Jackson, Daniel and Fenoll, Vicente and Farkas, Xénia and Baranowski, Paweł and Balaban, Delia},
