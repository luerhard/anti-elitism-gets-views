@article{ClingermayerDisentanglingPatternsState1995,
  title = {Disentangling {{Patterns}} of {{State Debt Financing}}},
  author = {Clingermayer, James C. and Wood, B. Dan},
  date = {1995-03-01},
  journaltitle = {The American Political Science Review},
  shortjournal = {The American Political Science Review},
  volume = {89},
  number = {1},
  eprint = {2083078},
  eprinttype = {JSTOR},
  pages = {108--120},
  issn = {0003-0554},
  doi = {10.2307/2083078},
  abstract = {We examine the determinants of change in state government indebtedness from 1961 through 1989 using a pooled time series cross-sectional analysis. The analysis reveals that debt is primarily a function of economic conditions reflecting both the need to borrow and the capacity of states to repay debt. However, political factors such as culture, partisan competition, and electoral cycles also affect state debt. We also find very weak evidence that tax and expenditure limitations, ironically, may increase state indebtedness, while constitutional debt limitations have no effect upon slowing the growth of state debt.}
}

@book{CloughAutoaffectionUnconsciousThought2000,
  title = {Autoaffection: {{Unconscious Thought}} in the {{Age}} of {{Teletechnology}}},
  shorttitle = {Autoaffection},
  author = {Clough, Patricia Ticineto},
  date = {2000},
  publisher = {University of MINNESOTA Press},
  abstract = {In this book, Patricia Ticineto Clough reenergizes critical theory by viewing poststructuralist thought through the lens of "teletechnology", using television as a recurring case study to illuminate the changing relationships between subjectivity, technology, and mass media.Autoaffection links diverse forms of cultural criticism – feminist theory, queer theory, film theory, postcolonial theory, Marxist cultural studies and literary criticism, the cultural studies of science and the criticism of ethnographic writing – to the transformation and expansion of teletechnology in the late twentieth century. These theoretical approaches, Clough suggests, have become the vehicles of unconscious thought in our time.In individual chapters, Clough juxtaposes the likes of Derridean deconstruction, Deleuzian philosophy, and Lacanian psychoanalysis. She works through the writings of Fredric Jameson, Donna Haraway, Judith Butler, Bruno Latour, Nancy Fraser, Elizabeth Grosz – to name only a few – placing all in dialogue with a teletechnological framework. Clough shows how these cultural criticisms have raised questions about the foundation of thought, allowing us to reenvision the relationship of nature and technology, the human and the machine, the virtual and the real, the living and the inert.},
  isbn = {978-0-8166-2889-6},
  langid = {english},
  pagetotal = {232},
  keywords = {Philosophy / History & Surveys / Modern,Psychology / Cognitive Psychology,Psychology / Ethnopsychology,Psychology / Movements / Psychoanalysis,Social Science / Sociology / General,Technology & Engineering / Social Aspects,Technology & Engineering / Television & Video}
}

